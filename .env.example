# ==========================================
# Notion2API Next - configuration template
# Copy to .env and fill in real values:
#   cp .env.example .env
# ==========================================

# ----------------------------------------------------------
# 1. Notion credentials (core)
# ----------------------------------------------------------
# Required fields: token_v2, space_id, user_id
# Multiple accounts = round-robin load balancing + rate-limit rotation.
#
# Recommended: run "python login.py" to capture the session from your browser
# and write accounts.json / .env automatically.
# Manual fallback: copy token_v2 from DevTools, then run
# scripts/extract_notion_info.js in the Notion console.
# ----------------------------------------------------------
NOTION_ACCOUNTS='[{"profile_name":"default","token_v2":"your_token","space_id":"your_space","user_id":"your_uid","space_view_id":"your_view","user_name":"your_name","user_email":"your_email"}]'

# ----------------------------------------------------------
# 2. HTTP service & security
# ----------------------------------------------------------
# Bearer token required from clients. Leave empty to disable auth.
API_KEY=
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# APP_MODE: lite | standard | heavy
#   standard - full context, thinking + search panels (default, recommended)
#   lite     - single-turn Q&A, lowest latency
#   heavy    - server-side conversation store (SQLite + SILICONFLOW_API_KEY)
APP_MODE=standard

# ----------------------------------------------------------
# 3. Notion upstream (2026-10 defaults)
# ----------------------------------------------------------
# Notion retired the www.notion.so AI endpoints and serves the web client from
# app.notion.com. Override NOTION_URL only for a mirror or a regional gateway.
NOTION_URL=https://app.notion.com
NOTION_DOMAIN=app.notion.com

# 出站代理（Clash / V2Ray 等，国内网络必需）
# NOTION_PROXY=http://127.0.0.1:7890

# Client version header. Notion bumps it with every web deploy; sync with the
# value in the app.notion.com HTML (data-notion-version attribute).
NOTION_CLIENT_VERSION=23.13.20261017.0323

# Chat transport:
#   agent_service - new Notion Agent protocol (createAgentThread +
#                   listenToThreadTranscript), used by the web UI since 2026-10
#   legacy        - old runInferenceTranscript protocol
NOTION_RUNTIME=agent_service

# Browser TLS fingerprint (needed: Notion rejects python-requests / cloudscraper
# JA3 on the AI endpoints). Requires curl_cffi.
NOTION_IMPERSONATE=chrome

# Single agent reply timeout (seconds) and optional thread cleanup.
AGENT_SERVICE_TIMEOUT_S=240
AGENT_SERVICE_DELETE_THREAD=false

# Legacy runtime debug overrides (leave false unless debugging).
NOTION_DEBUG_OVERRIDES=false

# ----------------------------------------------------------
# 4. Streaming keepalive
# ----------------------------------------------------------
# Long agent runs can be silent for minutes. Emit an SSE comment every N
# seconds so Cloudflare / nginx do not cut the connection.
STREAM_KEEPALIVE_S=15
FIRST_ITEM_WAIT_S=20

# ----------------------------------------------------------
# 5. Model defaults
# ----------------------------------------------------------
# Any id from GET /v1/models (see docs/MODEL_CATALOG.md). Empty = built-in
# default (claude-sonnet5.5). "auto" lets Notion pick (agent_service only).
DEFAULT_MODEL=claude-sonnet5.5

# ----------------------------------------------------------
# 6. Optional services / storage
# ----------------------------------------------------------
SILICONFLOW_API_KEY=
DB_PATH=./data/conversations.db
BIND_HOST=127.0.0.1
HOST_PORT=8000
LOG_LEVEL=INFO
TZ=Asia/Shanghai
